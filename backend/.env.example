# Cấu hình provider tạo nhạc.
# Sao chép file này thành ".env" rồi điền giá trị thật.

# Provider tạo nhạc: "mock" (mô phỏng, miễn phí) hoặc "sunoapi" (gọi API thật).
SUNO_PROVIDER=mock

# Chỉ cần khi SUNO_PROVIDER=sunoapi:
# API key từ nhà cung cấp third-party (vd sunoapi.org, apiframe.ai...).
SUNO_API_KEY=
# Base URL của nhà cung cấp (mặc định sunoapi.org).
SUNO_API_BASE=https://api.sunoapi.org
# Phiên bản model Suno (vd V4, V4_5...).
SUNO_MODEL=V4

# Cổng backend (mặc định 4000).
PORT=4000
